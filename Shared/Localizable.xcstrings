      "comment" : "App window: checkbox",
      "localizations" : {
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Использовать относительные пути для символических ссылок"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "为符号链接使用相对路径"
