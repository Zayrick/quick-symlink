/* Finder context menu: submenu title for symbolic link actions */
"SOFT_LINK_ACTIONS_EXTENTION_NAME" = "Symbolic Links";

/* Finder toolbar: tooltip for symbolic link actions */
"SOFT_LINK_ACTIONS_EXTENTION_TOOL_TIP" = "Create symbolic links to the selected items";

/* Finder context menu: submenu title for hard link actions */
"HARD_LINK_ACTIONS_EXTENTION_NAME" = "Hard Links";

/* Finder toolbar: tooltip for hard link actions */
"HARD_LINK_ACTIONS_EXTENTION_TOOL_TIP" = "Create hard links to the selected items";

/* Create links to the files copied with Command-C in the current folder */
